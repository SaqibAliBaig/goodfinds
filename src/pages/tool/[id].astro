  <script is:inline>
    const saveBtn = document.getElementById('saveDetailBtn');
    const saveIcon = document.getElementById('saveDetailIcon');
    const saveText = document.getElementById('saveDetailText');
    const copyBtn = document.getElementById('copyVaultBtn');
    const copyText = document.getElementById('copyVaultText');
    const prevLink = document.getElementById('prevToolLink');
    const nextLink = document.getElementById('nextToolLink');
    const toolId = saveBtn.getAttribute('data-id');

    function syncSavedState() {
      const saved = JSON.parse(localStorage.getItem('goodfinds_saved') || '[]');
      const isSaved = saved.includes(toolId);
      saveIcon.textContent = isSaved ? '★' : '☆';
      saveText.textContent = isSaved ? 'Saved' : 'Save';
      saveBtn.classList.toggle('is-saved', isSaved);
    }

    function toggleSaveTool() {
      let saved = JSON.parse(localStorage.getItem('goodfinds_saved') || '[]');
      if (saved.includes(toolId)) {
        saved = saved.filter((id) => id !== toolId);
      } else {
        saved.push(toolId);
      }
      localStorage.setItem('goodfinds_saved', JSON.stringify(saved));
      syncSavedState();
      window.dispatchEvent(new Event('goodfinds:saved-updated'));
    }

    saveBtn.addEventListener('click', toggleSaveTool);
    syncSavedState();

    if (copyBtn) {
      copyBtn.addEventListener('click', () => {
        navigator.clipboard.writeText(window.location.href);
        const orig = copyText.textContent;
        copyText.textContent = 'Copied ✓';
        setTimeout(() => {
          copyText.textContent = orig;
        }, 1600);
      });
    }

    const saveCompanionStackBtn = document.getElementById('saveCompanionStackBtn');
    if (saveCompanionStackBtn) {
      saveCompanionStackBtn.addEventListener('click', () => {
        const ids = (saveCompanionStackBtn.getAttribute('data-stack-ids') || '')
          .split(',')
          .map((s) => s.trim())
          .filter(Boolean);
        let saved = JSON.parse(localStorage.getItem('goodfinds_saved') || '[]');
        ids.forEach((id) => {
          if (!saved.includes(id)) saved.push(id);
        });
        localStorage.setItem('goodfinds_saved', JSON.stringify(saved));
        syncSavedState();
        window.dispatchEvent(new Event('goodfinds:saved-updated'));
        const origLabel = saveCompanionStackBtn.textContent;
        saveCompanionStackBtn.textContent = `✓ Saved All ${ids.length} Tools to Your Stack!`;
        setTimeout(() => {
          saveCompanionStackBtn.textContent = origLabel;
        }, 2200);
      });
    }

    // Gamma-only interactive ROI calculator
    const gammaSlider = document.getElementById('gammaDeckSlider');
    if (gammaSlider) {
      const countEl = document.getElementById('gammaDeckCount');
      const costEl = document.getElementById('gammaCostPerDeck');
      const hoursEl = document.getElementById('gammaHoursSaved');
      const verdictEl = document.getElementById('gammaCalcVerdict');

      function updateGammaRoi() {
        const decks = Math.max(1, parseInt(gammaSlider.value, 10) || 4);
        const costPerDeck = (8 / decks).toFixed(2);
        const hoursSaved = Math.round(decks * 2.5 * 10) / 10;

        if (countEl) countEl.textContent = `${decks} ${decks === 1 ? 'deck' : 'decks'} / mo`;
        if (costEl) costEl.textContent = `$${costPerDeck}`;
        if (hoursEl) hoursEl.textContent = `${hoursSaved} hrs / mo`;

        if (verdictEl) {
          if (decks <= 2) {
            verdictEl.textContent = `Even at ${decks} ${decks === 1 ? 'deck' : 'decks'}/mo, that's $${costPerDeck}/deck for badge-free exports and ${hoursSaved} hours of your life back.`;
          } else if (decks <= 6) {
            verdictEl.textContent = `Sweet spot: $${costPerDeck} per presentation—less than a coffee for watermark-free exports and ${hoursSaved} hours saved.`;
          } else {
            verdictEl.textContent = `Power presenter territory: just $${costPerDeck}/deck with unlimited AI generations, zero credit anxiety, and ${hoursSaved} hrs/mo reclaimed.`;
          }
        }
      }

      gammaSlider.addEventListener('input', updateGammaRoi);
      updateGammaRoi();
    }

    // Keyboard navigation: Left/Right arrows for Prev/Next tool, S to bookmark
    window.addEventListener('keydown', (e) => {
      const tag = (document.activeElement && document.activeElement.tagName) || '';
      if (tag === 'INPUT' || tag === 'TEXTAREA' || tag === 'SELECT') return;
      if (e.metaKey || e.ctrlKey || e.altKey) return;

      if (e.key === 'ArrowLeft' && prevLink) {
        window.location.href = prevLink.getAttribute('href');
      } else if (e.key === 'ArrowRight' && nextLink) {
        window.location.href = nextLink.getAttribute('href');
      } else if (e.key.toLowerCase() === 's') {
        e.preventDefault();
        toggleSaveTool();
      }
    });
  </script>
</Layout>
