          <span>Random</span>
        </button>

        <button
          type="button"
          class="theme-toggle-btn"
          id="themeToggleBtn"
          aria-label="Toggle color theme"
          title="Switch between minimal light and dark theme"
        >
          <svg class="sun-ico" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2"></path><path d="M12 20v2"></path><path d="m4.93 4.93 1.41 1.41"></path><path d="m17.66 17.66 1.41 1.41"></path><path d="M2 12h2"></path><path d="M20 12h2"></path><path d="m6.34 17.66-1.41 1.41"></path><path d="m19.07 4.93-1.41 1.41"></path></svg>
          <svg class="moon-ico" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path></svg>
          <span id="themeToggleLabel">Light</span>
        </button>

        <a href="#kit-newsletter" class="nl-pill-btn">
          Weekly Dispatch
        </a>
      </div>
    </div>
  </header>

  <!-- PAGE CONTENT -->
  <slot />

  <!-- KIT (CONVERTKIT) FREE WEEKLY NEWSLETTER BANNER -->
  <div class="container" id="kit-newsletter">
    <section class="kit-banner">
      <div class="kit-left">
        <div class="kit-eyebrow">
          <span class="kit-eyebrow-dot"></span>
          FRIDAY DISPATCH // FREE WEEKLY ARCHIVE
        </div>
        <div class="kit-copy">
          <h3>Five useful websites, every Friday.</h3>
          <p>Your weekly internet dispatch: 5 high-leverage websites, free browser utilities, and open-source tools worth bookmarking. Zero noise.</p>
        </div>
      </div>

      <form class="kit-form" action={data.site.kitActionUrl} method="post" onsubmit="handleKitSubmit(event)">
        <input
          type="email"
          name="email_address"
          id="kitEmailInput"
          class="kit-input"
          placeholder="you@domain.com"
          required
        />
        <button type="submit" class="kit-submit" id="kitSubmitBtn">Subscribe →</button>
      </form>
    </section>
  </div>

  <!-- VOLUNTARY BEEHIIV BOOSTS 1-CLICK PARTNER MODAL (Payout #1 on Friday Dispatch Signup) -->
  <div class="boost-modal-backdrop" id="beehiivBoostModal" style="display:none;">
    <div class="boost-modal">
      <div class="boost-head">
        <span class="boost-pill">✓ SUBSCRIBED TO FRIDAY DISPATCH</span>
        <h3>Want to also get these 3 free daily newsletters? (1-Click Subscribe)</h3>
        <p>Hand-picked free daily digests read by 2M+ students, builders, and creators:</p>
      </div>

      <div class="boost-list">
        <label class="boost-card">
          <input type="checkbox" checked />
          <div class="boost-info">
            <strong>The Rundown AI</strong>
            <span>Get the latest AI tools, workflows, and news in 5 minutes a day (Free).</span>
          </div>
        </label>
        <label class="boost-card">
          <input type="checkbox" checked />
          <div class="boost-info">
            <strong>Morning Brew</strong>
            <span>The witty 5-minute daily business and tech briefing (Free).</span>
          </div>
        </label>
        <label class="boost-card">
          <input type="checkbox" checked />
          <div class="boost-info">
            <strong>1440 Daily Digest</strong>
            <span>Unbiased, fact-focused daily world & science news in 5 minutes (Free).</span>
          </div>
        </label>
      </div>

      <button type="button" class="boost-continue-btn" id="boostContinueBtn">
        Complete 1-Click Subscribe →
      </button>
    </div>
  </div>

  <!-- FLOATING QUICK-TOP / SEARCH PILL -->
  <button type="button" class="quick-top-fab" id="quickTopFab" aria-label="Scroll back to top">
    <span>↑</span>
    <span>Top</span>
  </button>

  <!-- ARCHITECTURAL FOOTER -->
  <footer class="site-footer">
    <div class="container">
      <div class="footer-grid">
        <div class="footer-brand-col">
          <div class="footer-brand-top">
            <a href="/" class="brand-logo" style="font-size:1.15rem;">
              <span>GoodFinds</span><span class="brand-signal"></span>
            </a>
            <span class="footer-brand-badge">INDEX // #1—#{data.tools.length}+</span>
          </div>
          <p class="footer-tagline">
            A continuously expanding, numbered index of {data.tools.length}+ essential AI tools, free browser utilities, open-source replacements, and hidden internet gems.
          </p>
          <a
            href="https://x.com/SaqibBaig1100"
            target="_blank"
            rel="noopener"
            class="footer-x-pill"
            aria-label="Follow @SaqibBaig1100 on X"
          >
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4l11.733 16h4.267l-11.733 -16z"></path><path d="M4 20l6.768 -6.768m2.46 -2.46l6.772 -6.772"></path></svg>
            <span>@SaqibBaig1100</span>
          </a>
        </div>

        <div class="footer-col">
          <span class="footer-col-title">Directory</span>
          <a href="/">Numbered Index (#1–#{data.tools.length}+)</a>
          <a href="/compare">Free Alternatives ($0 Matrix)</a>
          <a href="/collections">Curated Collections</a>
          <a href="/saved">Saved Stack</a>
          <a href="/submit">Submit a Website</a>
        </div>

        <div class="footer-col">
          <span class="footer-col-title">Curated Collections</span>
          <a href="/collections/students">Student Collection</a>
          <a href="/collections/creators">Creator Collection</a>
          <a href="/collections/open-source-replacements">Open-Source Replacements</a>
          <a href="/collections/zero-login">Zero-Login Utilities</a>
          <a href="/collections/save-money">Save Money & Perks</a>
        </div>

        <div class="footer-col">
          <span class="footer-col-title">Popular Categories</span>
          <a href="/?cat=AI+tools">AI Tools</a>
          <a href="/?cat=File+%26+PDF+tools">File & PDF Tools</a>
          <a href="/?cat=Design">Design & Creative</a>
          <a href="/?cat=Career+%26+Coding">Career & Coding</a>
          <a href="/?cat=Privacy+%26+Security">Privacy & Security</a>
        </div>
      </div>

      <div class="footer-bottom">
        <span>© {new Date().getFullYear()} GoodFinds · {data.tools.length}+ Curated Websites · Expanding Weekly</span>
        <span class="footer-bottom-right">
          Curated by <a href="https://x.com/SaqibBaig1100" target="_blank" rel="noopener">@SaqibBaig1100</a>
        </span>
      </div>
    </div>
  </footer>

  <script is:inline define:vars={{ allToolIds }}>
    // Theme Toggle Handler
    const themeToggleBtn = document.getElementById('themeToggleBtn');
    const themeToggleLabel = document.getElementById('themeToggleLabel');

    function syncThemeUI() {
      const current = document.documentElement.getAttribute('data-theme') || 'dark';
      if (themeToggleLabel) {
        themeToggleLabel.textContent = current === 'light' ? 'Dark' : 'Light';
      }
    }

    syncThemeUI();

    if (themeToggleBtn) {
      themeToggleBtn.addEventListener('click', () => {
        const current = document.documentElement.getAttribute('data-theme') || 'dark';
        const next = current === 'light' ? 'dark' : 'light';
        document.documentElement.setAttribute('data-theme', next);
        localStorage.setItem('goodfinds_theme', next);
        syncThemeUI();
      });
    }

    // Update Saved Count Pill & Sync Inline Save Buttons Across Site
    function getNormalizedSaved() {
      const raw = JSON.parse(localStorage.getItem('goodfinds_saved') || '[]');
      const normalized = Array.from(new Set(raw.map((id) => String(parseInt(id, 10) || id))));
      if (JSON.stringify(raw) !== JSON.stringify(normalized)) {
        localStorage.setItem('goodfinds_saved', JSON.stringify(normalized));
      }
      return normalized;
    }

    function syncInlineSaveButtons() {
      const saved = getNormalizedSaved();
      const pill = document.getElementById('navSavedCount');
      if (pill) {
        if (saved.length > 0) {
          pill.textContent = String(saved.length);
          pill.style.display = 'inline-block';
        } else {
          pill.style.display = 'none';
        }
      }

      document.querySelectorAll('.inline-save-btn[data-save-id]').forEach((btn) => {
        const id = btn.getAttribute('data-save-id');
        const active = saved.includes(id);
        btn.textContent = active ? '★' : '☆';
        btn.classList.toggle('is-saved', active);
        btn.setAttribute('title', active ? `Saved (#${id}) — Click to remove` : `Bookmark #${id}`);
      });
    }

    window.syncInlineSaveButtons = syncInlineSaveButtons;
    syncInlineSaveButtons();
    if (window.optimizeImageLoading) {
      window.optimizeImageLoading();
      setTimeout(window.optimizeImageLoading, 50);
      setTimeout(window.optimizeImageLoading, 200);
    }
    window.addEventListener('storage', syncInlineSaveButtons);
    window.addEventListener('goodfinds:saved-updated', syncInlineSaveButtons);

    // Global delegated click handler for inline ☆ bookmark buttons
    document.addEventListener('click', (e) => {
      const btn = e.target.closest('.inline-save-btn[data-save-id]');
      if (!btn) return;
      e.preventDefault();
      e.stopPropagation();

      const id = btn.getAttribute('data-save-id');
      if (!id) return;

      let saved = JSON.parse(localStorage.getItem('goodfinds_saved') || '[]');
      if (saved.includes(id)) {
        saved = saved.filter((item) => item !== id);
      } else {
        saved.push(id);
      }
      localStorage.setItem('goodfinds_saved', JSON.stringify(saved));
      window.dispatchEvent(new Event('goodfinds:saved-updated'));
    });

    // Random Gem Teleport
    function jumpToRandomGem() {
      if (!allToolIds || !allToolIds.length) return;
      const currentPath = window.location.pathname;
      const pool = allToolIds.filter((id) => !currentPath.endsWith(`/tool/${id}`));
      const pick = pool[Math.floor(Math.random() * pool.length)] || allToolIds[0];
      window.location.href = `/tool/${pick}`;
    }

    const randomGemBtn = document.getElementById('randomGemBtn');
    if (randomGemBtn) {
      randomGemBtn.addEventListener('click', jumpToRandomGem);
    }

    // Global Keyboard Shortcuts: Cmd+K (Search), R (Random Gem)
    window.addEventListener('keydown', (e) => {
      const tag = (document.activeElement && document.activeElement.tagName) || '';
      const isTyping = tag === 'INPUT' || tag === 'TEXTAREA' || tag === 'SELECT';

      if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
        e.preventDefault();
        const searchInput = document.getElementById('heroSearchInput') || document.getElementById('exploreSearch');
        if (searchInput) {
          searchInput.focus();
          searchInput.select();
        } else {
          window.location.href = '/explore';
        }
        return;
      }

      if (!isTyping && !e.metaKey && !e.ctrlKey && !e.altKey && e.key.toLowerCase() === 'r') {
        e.preventDefault();
        jumpToRandomGem();
      }
    });

    window.handleKitSubmit = function (e) {
      const form = e.target;
      const action = form.getAttribute('action') || '';
      const email = document.getElementById('kitEmailInput').value.trim();
      if (!email) return;

      const subs = JSON.parse(localStorage.getItem('goodfinds_kit_subs') || '[]');
      subs.push({ email, date: new Date().toISOString() });
      localStorage.setItem('goodfinds_kit_subs', JSON.stringify(subs));

      if (action.includes('YOUR_KIT_FORM_ID')) {
        e.preventDefault();
        const btn = document.getElementById('kitSubmitBtn');
        btn.textContent = 'Subscribed ✓';
        document.getElementById('kitEmailInput').value = '';
        const boostModal = document.getElementById('beehiivBoostModal');
        if (boostModal) boostModal.style.display = 'flex';
      }
    };

    const boostContinueBtn = document.getElementById('boostContinueBtn');
    const boostModalEl = document.getElementById('beehiivBoostModal');
    if (boostContinueBtn && boostModalEl) {
      boostContinueBtn.addEventListener('click', () => {
        boostModalEl.style.display = 'none';
      });
      boostModalEl.addEventListener('click', (e) => {
        if (e.target === boostModalEl) boostModalEl.style.display = 'none';
      });
    }

    // Smart Mobile Headroom & Quick-Top Pill
    const topbarEl = document.querySelector('.topbar');
    const quickTopFab = document.getElementById('quickTopFab');
    let lastScrollY = window.scrollY || 0;

    window.addEventListener(
      'scroll',
      () => {
        const y = window.scrollY || 0;
        const delta = y - lastScrollY;

        if (topbarEl) {
          if (y <= 60) {
            topbarEl.classList.remove('topbar-hidden');
          } else if (delta > 8 && y > 80) {
            topbarEl.classList.add('topbar-hidden');
          } else if (delta < -6) {
            topbarEl.classList.remove('topbar-hidden');
          }
        }

        if (quickTopFab) {
          quickTopFab.classList.toggle('visible', y > 450);
        }

        lastScrollY = y;
      },
      { passive: true }
    );

    if (quickTopFab) {
      quickTopFab.addEventListener('click', () => {
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });
    }
  </script>
</body>
</html>
