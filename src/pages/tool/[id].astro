      font-size: 0.72rem;
      font-weight: 800;
      color: var(--text-secondary);
      letter-spacing: 0.04em;
    }

    .gu-tier-tag.plus-tag {
      color: var(--text);
    }

    .gu-tier-status {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.6rem;
      font-weight: 700;
      padding: 2px 8px;
      border-radius: 5px;
      letter-spacing: 0.04em;
    }

    .gu-tier-status.muted {
      color: var(--text-muted);
      background: var(--bg-inset);
      border: 1px solid var(--border);
    }

    .gu-tier-status.hot {
      color: #090a0d;
      background: #a8ff29;
    }

    :global(:root[data-theme="light"]) .gu-tier-status.hot {
      color: #ffffff;
      background: #059669;
    }

    /* MINI SLIDE MOCKUPS (WATERMARK VS. CLEAN) */
    .gu-slide-mock {
      position: relative;
      height: 62px;
      border-radius: 8px;
      padding: 11px 13px;
      border: 1px solid var(--border);
      background: var(--bg-inset);
      display: flex;
      align-items: flex-start;
      overflow: hidden;
    }

    .gu-slide-mock.plus-mock {
      border-color: rgba(168, 255, 41, 0.22);
    }

    :global(:root[data-theme="light"]) .gu-slide-mock.plus-mock {
      border-color: rgba(5, 150, 105, 0.25);
    }

    .mock-lines {
      display: flex;
      flex-direction: column;
      gap: 6px;
      width: 58%;
    }

    .ml-title {
      height: 7px;
      width: 68%;
      border-radius: 3px;
      background: var(--border-hover);
    }

    .ml-bar {
      height: 5px;
      width: 100%;
      border-radius: 3px;
      background: var(--border-light);
    }

    .ml-bar.short {
      width: 72%;
    }

    .mock-watermark-pill {
      position: absolute;
      right: 8px;
      bottom: 7px;
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.58rem;
      font-weight: 700;
      color: #f59e0b;
      background: rgba(245, 158, 11, 0.14);
      border: 1px dashed rgba(245, 158, 11, 0.5);
      padding: 2px 7px;
      border-radius: 4px;
    }

    :global(:root[data-theme="light"]) .mock-watermark-pill {
      color: #b45309;
      background: rgba(245, 158, 11, 0.12);
      border-color: rgba(180, 83, 9, 0.45);
    }

    .mock-clean-pill {
      position: absolute;
      right: 8px;
      bottom: 7px;
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.58rem;
      font-weight: 700;
      color: var(--emerald-ink);
      background: rgba(16, 185, 129, 0.12);
      border: 1px solid rgba(16, 185, 129, 0.35);
      padding: 2px 7px;
      border-radius: 4px;
    }

    .gu-list {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 7px;
    }

    .gu-list li {
      font-size: 0.79rem;
      color: var(--text-secondary);
      line-height: 1.45;
      position: relative;
      padding-left: 18px;
