---
import Layout from '../../layouts/Layout.astro';
import data from '../../data/tools.json';

export function getStaticPaths() {
  return data.tools.map((tool, index) => {
    const prevTool = index > 0 ? data.tools[index - 1] : data.tools[data.tools.length - 1];
    const nextTool = index < data.tools.length - 1 ? data.tools[index + 1] : data.tools[0];
    return {
      params: { id: tool.id },
      props: { tool, prevTool, nextTool },
    };
  });
}

const { tool, prevTool, nextTool } = Astro.props;

const relatedTools = data.tools
  .filter((t) => t.id !== tool.id && t.category === tool.category)
  .slice(0, 4);

const trackedUrl = tool.isAffiliate ? tool.url : `${tool.url}${tool.url.includes('?') ? '&' : '?'}utm_source=goodfinds&utm_medium=tool_page&subid=tool_${tool.id}`;

const deepOverview = tool.deepOverview || [tool.whatItDoes];
const keyFeatures = tool.keyFeatures || (tool.whyWeLikeIt || []).map((pt, i) => ({ title: `Key Capability #${i + 1}`, desc: pt }));
const workflowSteps = tool.workflowSteps || [];
const drawbacks = tool.drawbacks || [{ label: 'Primary Limitation', detail: tool.limitations }];
const pricingTiers = tool.pricingTiers || [];
const specs = tool.specs || {
  loginRequired: 'Free Account / Instant',
  creditCard: 'No ($0 to Start)',
  platforms: 'Web Browser (Desktop & Mobile)',
  exportFormats: 'Standard Web & File Exports',
  privacyPosture: 'Verified HTTPS Access',
  bestFor: 'Students, Creators & Builders',
  replaces: 'Paid SaaS Subscriptions',
  proTip: `Bookmark #${tool.id} with ☆ to save it to your custom stack.`
};
const faqs = tool.faqs || [];

const toolMetaDescription = `${tool.name} (#${tool.id}) review: ${tool.tagline} Verified access: ${tool.pricingBadge}. Explore pricing tiers, features, drawbacks & workflows on GoodFinds.`;

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://goodfinds.tech"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": tool.category || "Tools",
      "item": "https://goodfinds.tech/explore"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": `#${tool.id} ${tool.name}`,
      "item": `https://goodfinds.tech/tool/${tool.id}`
    }
  ]
};

const softwareSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": tool.name,
  "applicationCategory": tool.category || "Utility",
  "operatingSystem": "Web, Windows, macOS, Linux, iOS, Android",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD",
    "description": tool.freePlan || "Free tier available"
  },
  "description": tool.whatItDoes || tool.tagline,
  "url": `https://goodfinds.tech/tool/${tool.id}`
};

const faqSchema = faqs.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": f.a
    }
  }))
} : null;

const toolSchemas = [breadcrumbSchema, softwareSchema, ...(faqSchema ? [faqSchema] : [])];
---

<Layout
  title={`#${tool.id} ${tool.name} — In-Depth Review, Pricing, Features & Drawbacks — GoodFinds`}
  description={toolMetaDescription}
  canonical={`https://goodfinds.tech/tool/${tool.id}`}
  type="article"
  jsonLd={toolSchemas}
  activeNav="explore"
>
  <main class="container detail-page">
    <!-- TOP CONTROL BAR WITH KEYBOARD NAVIGATION -->
    <div class="dossier-toolbar">
      <a href="/" class="ctrl-btn">← <span class="hide-xs">Complete </span>Index<span class="hide-xs"> (#1–#{data.tools.length})</span></a>

      <div class="toolbar-right">
        <div class="cycle-group">
          <a href={`/tool/${prevTool.id}`} id="prevToolLink" class="cycle-btn" title={`Previous: #${prevTool.id} ${prevTool.name}`}>
            <span>← #{prevTool.id}</span>
            <span class="cycle-name">{prevTool.name}</span>
          </a>
          <span class="cycle-sep"></span>
          <a href={`/tool/${nextTool.id}`} id="nextToolLink" class="cycle-btn" title={`Next: #${nextTool.id} ${nextTool.name}`}>
            <span class="cycle-name">{nextTool.name}</span>
            <span>#{nextTool.id} →</span>
          </a>
        </div>

        <button type="button" class="ctrl-btn" id="copyVaultBtn">
          <span id="copyVaultText">Copy #{tool.id}</span>
        </button>

        <button type="button" class="ctrl-btn save-pill-btn" id="saveDetailBtn" data-id={tool.id} title="Bookmark tool">
          <span id="saveDetailIcon">☆</span>
          <span id="saveDetailText">Save</span>
        </button>
      </div>
    </div>

    <!-- ARCHITECTURAL DOSSIER FRAME -->
    <section class="dossier-frame">
      <!-- 1. DOSSIER HEADER (MINIMAL — APP ICON, NAME & TITLE ONLY) -->
      <div class="dossier-head">
        <div class="dossier-identity">
          <div class="dossier-favicon">
            <img
              src={`https://www.google.com/s2/favicons?domain=${tool.domain}&sz=64`}
              alt={tool.name}
              width="30"
              height="30"
              decoding="async"
              data-image-component="true"
            />
          </div>
          <div class="dossier-title-block">
            <div class="dossier-eyebrow">
              <span class="mono-num">#{tool.id}</span>
              <span class="dot-sep">·</span>
              <span class="domain-mono">{tool.domain}</span>
            </div>
            <h1>{tool.name}</h1>
            <p class="tagline">{tool.tagline}</p>
          </div>
        </div>

        <div class="dossier-head-cta">
          <a
            href={trackedUrl}
            target="_blank"
            rel={`noopener ${tool.isAffiliate ? 'sponsored' : ''}`}
            class="primary-launch-btn"
          >
            <span>Open {tool.domain}</span>
            <span class="arr-diag">↗</span>
          </a>
        </div>
      </div>

      <!-- 2. 6-CELL TECHNICAL SPECIFICATION STRIP -->
      <div class="spec-strip">
        <div class="spec-cell">
          <span class="spec-label">VAULT COORDINATE</span>
          <span class="spec-val">#{tool.id} of {data.tools.length}</span>
        </div>
        <div class="spec-cell">
          <span class="spec-label">PRIMARY CATEGORY</span>
          <span class="spec-val">{tool.category}</span>
        </div>
        <div class="spec-cell">
          <span class="spec-label">ACCESS MODEL</span>
          <span class="spec-val status-verified">
            <span class="v-dot"></span>
            {tool.pricingBadge}
          </span>
        </div>
        <div class="spec-cell">
          <span class="spec-label">ACCOUNT REQUIREMENT</span>
          <span class="spec-val">{specs.loginRequired}</span>
        </div>
        <div class="spec-cell">
          <span class="spec-label">CREDIT CARD GATE</span>
          <span class="spec-val">{specs.creditCard}</span>
        </div>
        <div class="spec-cell">
          <span class="spec-label">VERIFIED HOSTNAME</span>
          <span class="spec-val">{tool.domain}</span>
        </div>
      </div>

      <!-- 3. TWO-COLUMN IN-DEPTH ARCHITECTURAL SPLIT -->
      <div class="dossier-split">
        <!-- LEFT COLUMN: DEEP EDITORIAL BREAKDOWN -->
        <div class="editorial-col">
          <!-- SECTION 1: OVERVIEW & ARCHITECTURE -->
          <div class="ed-block">
            <div class="ed-label">1 // EXECUTIVE OVERVIEW & CORE FUNCTION</div>
            <div class="overview-paragraphs">
              {deepOverview.map((para) => (
                <p class="ed-lead">{para}</p>
              ))}
            </div>

            <div class="quick-meta-grid">
              <div class="qm-box">
                <span class="qm-label">REPLACES / SAVES MONEY ON</span>
                <strong class="qm-val">{specs.replaces}</strong>
              </div>
              <div class="qm-box">
                <span class="qm-label">IDEAL USER PROFILE</span>
                <strong class="qm-val">{specs.bestFor}</strong>
              </div>
              <div class="qm-box">
                <span class="qm-label">SUPPORTED FORMATS & EXPORTS</span>
                <strong class="qm-val">{specs.exportFormats}</strong>
              </div>
            </div>
          </div>

          <!-- SECTION 2: COMPLETE FEATURE & CAPABILITY MATRIX -->
          <div class="ed-block">
            <div class="ed-label">2 // IN-DEPTH FEATURES & CAPABILITIES</div>
            <div class="feature-matrix-grid">
              {keyFeatures.map((feat) => (
                <div class="feat-card">
                  <h3 class="feat-title">{feat.title}</h3>
                  <p class="feat-desc">{feat.desc}</p>
                </div>
              ))}
            </div>
          </div>

          <!-- SECTION 3: STEP-BY-STEP TACTICAL WORKFLOW -->
          {workflowSteps.length > 0 && (
            <div class="ed-block">
              <div class="ed-label">3 // HOW TO USE IT FOR $0 (STEP-BY-STEP WORKFLOW)</div>
              <div class="workflow-list">
                {workflowSteps.map((wf) => (
                  <div class="wf-card">
                    <div class="wf-step-tag">{wf.step}</div>
                    <div class="wf-body">
                      <h4>{wf.title}</h4>
                      <p>{wf.detail}</p>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          )}

          <!-- SECTION 4: HONEST DRAWBACKS, CATCHES & LIMITATIONS -->
          <div class="ed-block">
            <div class="ed-label">4 // HONEST DRAWBACKS, CATCHES & LIMITATIONS</div>
            <div class="drawbacks-grid">
              {drawbacks.map((db) => (
                <div class="drawback-card">
                  <strong class="db-label">{db.label}</strong>
                  <p class="db-detail">{db.detail}</p>
                </div>
              ))}
            </div>
          </div>

          <!-- SECTION 5: FREQUENTLY ASKED QUESTIONS -->
          {faqs.length > 0 && (
            <div class="ed-block last">
              <div class="ed-label">5 // FREQUENTLY ASKED QUESTIONS ABOUT #{tool.id} {tool.name.toUpperCase()}</div>
              <div class="faq-list">
                {faqs.map((item) => (
                  <div class="faq-card">
                    <h4 class="faq-q">{item.q}</h4>
                    <p class="faq-a">{item.a}</p>
                  </div>
                ))}
              </div>
            </div>
          )}
        </div>

        <!-- RIGHT SIDEBAR: COMPLETE PRICING PLANS, SCORECARD & COMPANIONS -->
        <aside class="spec-sidebar">
          <!-- COMPLETE PRICING PLANS BREAKDOWN -->
          <div class="sidebar-section">
            <div class="ed-label">COMPLETE PRICING PLANS & TIER BREAKDOWN</div>

            <div class="pricing-tiers-stack">
              {pricingTiers.map((tier, idx) => (
                <div class={`pricing-tier-card ${idx === 0 ? 'primary-free-tier' : ''}`}>
                  <div class="pt-head">
                    <span class="pt-name">{tier.tierName}</span>
                    <div class="pt-price">{tier.price}</div>
                  </div>
                  <p class="pt-summary">{tier.summary}</p>
                  {tier.bullets && tier.bullets.length > 0 && (
                    <ul class="pt-bullets">
                      {tier.bullets.map((b) => (
                        <li>{b}</li>
                      ))}
                    </ul>
                  )}
                </div>
              ))}
            </div>

            {tool.pricingVerdict && (
              <div class="verdict-callout">
                <div class="verdict-label">EDITORIAL PRICING VERDICT // DO YOU NEED TO PAY?</div>
                <p>{tool.pricingVerdict}</p>
              </div>
            )}
          </div>

          <!-- TECHNICAL & PRIVACY SCORECARD -->
          <div class="sidebar-section">
            <div class="ed-label">TECHNICAL & PRIVACY SCORECARD</div>
            <div class="scorecard-table">
              <div class="sc-row">
                <span class="sc-key">Verified Domain</span>
                <span class="sc-val">{tool.domain}</span>
              </div>
              <div class="sc-row">
                <span class="sc-key">Starting Price</span>
                <span class="sc-val emerald">$0.00 ({tool.pricingBadge})</span>
              </div>
              <div class="sc-row">
                <span class="sc-key">Account / Login</span>
                <span class="sc-val">{specs.loginRequired}</span>
              </div>
              <div class="sc-row">
                <span class="sc-key">Credit Card Required</span>
                <span class="sc-val">{specs.creditCard}</span>
              </div>
              <div class="sc-row">
                <span class="sc-key">Platforms</span>
                <span class="sc-val">{specs.platforms}</span>
              </div>
              <div class="sc-row">
                <span class="sc-key">Privacy Architecture</span>
                <span class="sc-val">{specs.privacyPosture}</span>
              </div>
            </div>

            <div class="protip-box">
              <span class="protip-tag">PRO TIP //</span>
              <p>{specs.proTip}</p>
            </div>
          </div>

          <!-- PRIMARY CTA BLOCK -->
          <div class="sidebar-cta-block">
            <a
              href={trackedUrl}
              target="_blank"
              rel={`noopener ${tool.isAffiliate ? 'sponsored' : ''}`}
              class="visit-btn"
            >
              Launch {tool.name} (#{tool.id}) ↗
            </a>

            <p class="disclosure">
              Editorial independence: Every website in the index (#1–#{data.tools.length}) is verified to offer a genuine free tier, open-source license, or no-login utility. Partner links never affect your price.
            </p>
          </div>
        </aside>
      </div>
    </section>

    <!-- CONTEXTUAL RELATED RECOMMENDATIONS -->
    <div class="sec-header" style="margin-top:44px;">
      <div class="sec-title">
        <span class="sec-index">RELATED //</span>
        <span>Adjacent Tools in {tool.category}</span>
      </div>
    </div>

    <div class="related-bento">
      {relatedTools.map((rel) => (
        <a href={`/tool/${rel.id}`} class="rel-cell">
          <div class="rel-mid">
            <div class="rel-ico">
              <img
                src={`https://www.google.com/s2/favicons?domain=${rel.domain}&sz=64`}
                alt={rel.name}
                width="18"
                height="18"
                decoding="async"
                data-image-component="true"
                loading="lazy"
              />
            </div>
            <div>
              <h3>{rel.name}</h3>
              <span class="rel-dom">{rel.domain}</span>
            </div>
          </div>
          <p>{rel.tagline}</p>
          <div class="rel-foot">
            <span>Open</span>
            <span class="arr-diag">↗</span>
          </div>
        </a>
      ))}
    </div>
  </main>

  <style>
    .detail-page {
      padding-top: 28px;
    }

    /* TOP CONTROL TOOLBAR */
    .dossier-toolbar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 12px;
      margin-bottom: 16px;
      flex-wrap: wrap;
    }

    .toolbar-right {
      display: flex;
      align-items: center;
      gap: 8px;
      flex-wrap: wrap;
    }

    .ctrl-btn {
      background: var(--bg-card);
      border: 1px solid var(--border);
      color: var(--text-secondary);
      height: 34px;
      padding: 0 12px;
      border-radius: 8px;
      font-family: inherit;
      font-size: 0.76rem;
      font-weight: 500;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      cursor: pointer;
      transition: all 0.14s ease;
    }

    .ctrl-btn:hover,
    .save-pill-btn.is-saved {
      border-color: var(--border-hover);
      color: var(--text);
    }

    .kbd-hint {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.62rem;
      color: var(--text-muted);
      background: var(--bg-inset);
      border: 1px solid var(--border);
      padding: 1px 5px;
      border-radius: 4px;
    }

    .cycle-group {
      display: inline-flex;
      align-items: center;
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: 8px;
      height: 34px;
      overflow: hidden;
    }

    .cycle-btn {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.72rem;
      color: var(--text-secondary);
      padding: 0 11px;
      height: 100%;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      transition: background-color 0.14s ease, color 0.14s ease;
    }

    .cycle-btn:hover {
      background: var(--bg-card-hover);
      color: var(--text);
    }

    .cycle-name {
      font-family: 'Inter', sans-serif;
      font-weight: 500;
      color: var(--text-muted);
    }

    .cycle-sep {
      width: 1px;
      height: 16px;
      background: var(--border);
    }

    /* ARCHITECTURAL DOSSIER FRAME */
    .dossier-frame {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: 12px;
      overflow: hidden;
      box-shadow: var(--shadow-card);
    }

    .dossier-head {
      padding: 28px 32px;
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 24px;
      border-bottom: 1px solid var(--border);
    }

    .dossier-identity {
      display: flex;
      align-items: flex-start;
      gap: 20px;
    }

    .dossier-favicon {
      width: 56px;
      height: 56px;
      border-radius: 12px;
      background: var(--bg-icon);
      border: 1px solid var(--border);
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }

    .dossier-favicon img {
      width: 30px;
      height: 30px;
      object-fit: contain;
    }

    .dossier-eyebrow {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.7rem;
      color: var(--text-muted);
      letter-spacing: 0.04em;
      display: flex;
      align-items: center;
      gap: 8px;
      flex-wrap: wrap;
      margin-bottom: 6px;
    }

    .mono-num {
      color: var(--text);
      font-weight: 700;
    }

    .cat-badge-inline {
      background: var(--bg-inset);
      border: 1px solid var(--border);
      color: var(--text-secondary);
      padding: 1px 7px;
      border-radius: 4px;
      font-size: 0.65rem;
    }

    .dossier-title-block h1 {
      font-size: 2.05rem;
      font-weight: 800;
      letter-spacing: -0.035em;
      line-height: 1.1;
      margin-bottom: 6px;
    }

    .tagline {
      color: var(--text-secondary);
      font-size: 0.96rem;
      max-width: 620px;
      line-height: 1.5;
    }

    .col-badges-row {
      display: flex;
      align-items: center;
      gap: 6px;
      flex-wrap: wrap;
      margin-top: 12px;
    }

    .dossier-col-pill {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.66rem;
      font-weight: 600;
      color: var(--text-secondary);
      background: var(--bg-inset);
      border: 1px solid var(--border);
      padding: 3px 9px;
      border-radius: 6px;
      transition: border-color 0.14s ease, color 0.14s ease;
    }

    .dossier-col-pill:hover {
      border-color: var(--border-hover);
      color: var(--text);
    }

    .dossier-head-cta {
      display: flex;
      flex-direction: column;
      align-items: flex-end;
      gap: 6px;
      flex-shrink: 0;
    }

    .primary-launch-btn {
      background: var(--btn-primary-bg);
      color: var(--btn-primary-text);
      font-size: 0.84rem;
      font-weight: 600;
      padding: 12px 20px;
      border-radius: 8px;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      white-space: nowrap;
      transition: opacity 0.15s ease, transform 0.15s ease;
    }

    .primary-launch-btn:hover {
      opacity: 0.9;
      transform: translateY(-1px);
    }

    .cta-sub-note {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.64rem;
      color: var(--text-muted);
    }

    /* 6-CELL TECHNICAL SPECIFICATION STRIP */
    .spec-strip {
      display: grid;
      grid-template-columns: repeat(6, minmax(0, 1fr));
      gap: 1px;
      background: var(--border);
      border-bottom: 1px solid var(--border);
    }

    .spec-cell {
      background: var(--bg-inset);
      padding: 12px 16px;
      display: flex;
      flex-direction: column;
      gap: 3px;
      min-width: 0;
    }

    .spec-label {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.6rem;
      color: var(--text-muted);
      letter-spacing: 0.05em;
    }

    .spec-val {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.74rem;
      font-weight: 600;
      color: var(--text);
      display: inline-flex;
      align-items: center;
      gap: 6px;
      line-height: 1.3;
    }

    .v-dot {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: #16a34a;
      flex-shrink: 0;
    }

    /* TWO-COLUMN SPLIT */
    .dossier-split {
      display: grid;
      grid-template-columns: minmax(0, 1.58fr) minmax(0, 1fr);
    }

    .editorial-col {
      padding: 28px 32px;
      border-right: 1px solid var(--border);
      display: flex;
      flex-direction: column;
      gap: 30px;
    }

    .ed-block {
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    .ed-label {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.68rem;
      font-weight: 700;
      letter-spacing: 0.06em;
      color: var(--text-muted);
      padding-bottom: 8px;
      border-bottom: 1px solid var(--border-subtle);
    }

    .overview-paragraphs {
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    .ed-lead {
      font-size: 0.92rem;
      color: var(--text-body);
      line-height: 1.65;
    }

    .quick-meta-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 10px;
      margin-top: 4px;
    }

    .qm-box {
      background: var(--bg-inset);
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 12px 14px;
      display: flex;
      flex-direction: column;
      gap: 4px;
    }

    .qm-label {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.6rem;
      font-weight: 600;
      color: var(--text-muted);
      letter-spacing: 0.04em;
    }

    .qm-val {
      font-size: 0.8rem;
      font-weight: 600;
      color: var(--text);
      line-height: 1.4;
    }

    /* FEATURE MATRIX GRID */
    .feature-matrix-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
