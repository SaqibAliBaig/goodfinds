        padding: 10px 16px;
      }
      .site-footer {
        padding: 26px 0 24px;
      }
      .footer-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 18px 14px;
        padding-bottom: 20px;
      }
      .footer-brand-col {
        grid-column: 1 / -1;
        max-width: 100%;
      }
      .footer-bottom {
        flex-direction: column;
        align-items: flex-start;
        gap: 6px;
        padding-top: 14px;
        font-size: 0.7rem;
      }
    }
  </style>
</head>
<body>

  <!-- TOP NAVIGATION -->
  <header class="topbar">
    <div class="container topbar-inner">
