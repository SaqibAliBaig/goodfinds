      transition: opacity 0.15s ease, transform 0.15s ease;
    }

    .primary-launch-btn:hover {
      opacity: 0.9;
      transform: translateY(-1px);
    }

    .cta-sub-note {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.64rem;
      color: var(--text-muted);
    }

    /* 6-CELL TECHNICAL SPECIFICATION STRIP */
    .spec-strip {
      display: grid;
      grid-template-columns: repeat(6, minmax(0, 1fr));
      gap: 1px;
      background: var(--border);
      border-bottom: 1px solid var(--border);
    }

    .spec-cell {
      background: var(--bg-inset);
      padding: 12px 16px;
      display: flex;
      flex-direction: column;
      gap: 3px;
      min-width: 0;
    }

    .spec-label {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.6rem;
      color: var(--text-muted);
      letter-spacing: 0.05em;
    }

    .spec-val {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.74rem;
      font-weight: 600;
      color: var(--text);
      display: inline-flex;
      align-items: center;
      gap: 6px;
      line-height: 1.3;
    }

    .v-dot {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: #16a34a;
      flex-shrink: 0;
    }

    /* GAMMA-ONLY HIGH-CONVERSION UPGRADE SPOTLIGHT (#1) */
    #workflow-trick {
      scroll-margin-top: 86px;
    }

    .gamma-upgrade-spotlight {
      position: relative;
      padding: 28px 32px;
      border-bottom: 1px solid var(--border);
      background:
        radial-gradient(ellipse 65% 80% at 92% 0%, rgba(168, 255, 41, 0.095), transparent 65%),
        radial-gradient(ellipse 50% 70% at 8% 100%, rgba(139, 92, 246, 0.07), transparent 65%),
        linear-gradient(180deg, rgba(16, 18, 23, 0.98) 0%, var(--bg-inset) 100%);
      display: flex;
      flex-direction: column;
      gap: 20px;
    }

    :global(:root[data-theme="light"]) .gamma-upgrade-spotlight {
      background:
        radial-gradient(ellipse 65% 80% at 92% 0%, rgba(5, 150, 105, 0.08), transparent 65%),
        radial-gradient(ellipse 50% 70% at 8% 100%, rgba(91, 33, 182, 0.045), transparent 65%),
        linear-gradient(180deg, #ffffff 0%, #f5f4ef 100%);
    }

    .gu-top-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      flex-wrap: wrap;
    }

    .gu-kicker {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.67rem;
      font-weight: 700;
      letter-spacing: 0.06em;
      color: var(--lime-ink);
      background: var(--lime-soft);
      border: 1px solid var(--lime-border);
      padding: 4px 10px;
      border-radius: 999px;
    }

    :global(:root[data-theme="light"]) .gu-kicker {
      color: #047857;
      background: rgba(5, 150, 105, 0.09);
      border-color: rgba(5, 150, 105, 0.28);
    }

    .gu-pulse {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: #a8ff29;
      box-shadow: 0 0 8px rgba(168, 255, 41, 0.85);
      flex-shrink: 0;
    }

    :global(:root[data-theme="light"]) .gu-pulse {
      background: #059669;
      box-shadow: 0 0 0 3px rgba(5, 150, 105, 0.18);
    }

    .gu-anchor-pill {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.66rem;
      font-weight: 600;
      color: var(--text-secondary);
      background: var(--bg-card);
      border: 1px solid var(--border);
      padding: 4px 10px;
      border-radius: 6px;
    }

    .gu-header-grid {
      display: grid;
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
      gap: 24px;
      align-items: center;
    }

    .gu-title {
      font-size: clamp(1.32rem, 2.2vw, 1.72rem);
      font-weight: 800;
      letter-spacing: -0.03em;
      line-height: 1.18;
      color: var(--text);
      margin-bottom: 10px;
    }

    .gu-serif {
      font-family: 'Instrument Serif', Georgia, serif;
      font-weight: 400;
      font-style: italic;
      font-size: 1.12em;
      letter-spacing: -0.005em;
      color: var(--lime-ink);
    }

    :global(:root[data-theme="light"]) .gu-serif {
      color: #047857;
    }

    .gu-sub {
      font-size: 0.88rem;
      color: var(--text-secondary);
      line-height: 1.6;
    }

    .gu-sub strong {
      color: var(--text);
      font-weight: 600;
    }

    /* INTERACTIVE ROI CALCULATOR CARD */
    .gu-calc-card {
      background: var(--bg-card);
      border: 1px solid var(--border-light);
      border-radius: 11px;
      padding: 16px 18px;
      display: flex;
      flex-direction: column;
      gap: 12px;
      box-shadow: 0 8px 28px rgba(0, 0, 0, 0.22);
    }

    :global(:root[data-theme="light"]) .gu-calc-card {
      box-shadow: 0 6px 20px rgba(0, 0, 0, 0.05);
    }

    .gu-calc-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
    }

    .gu-calc-label {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.62rem;
      font-weight: 700;
      letter-spacing: 0.05em;
      color: var(--text-muted);
    }

    .gu-calc-count {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.78rem;
      font-weight: 700;
      color: var(--text);
      background: var(--bg-inset);
      border: 1px solid var(--border);
      padding: 2px 9px;
      border-radius: 6px;
    }

    .gu-slider {
      width: 100%;
      height: 6px;
      border-radius: 999px;
      background: var(--border-light);
      outline: none;
      -webkit-appearance: none;
      appearance: none;
      cursor: pointer;
    }

    .gu-slider::-webkit-slider-thumb {
      -webkit-appearance: none;
      appearance: none;
      width: 18px;
      height: 18px;
      border-radius: 50%;
      background: #a8ff29;
      border: 2px solid #090a0d;
      box-shadow: 0 0 0 3px rgba(168, 255, 41, 0.25);
      cursor: pointer;
      transition: transform 0.12s ease;
    }

    .gu-slider::-webkit-slider-thumb:hover {
      transform: scale(1.12);
    }

    .gu-slider::-moz-range-thumb {
      width: 18px;
      height: 18px;
      border-radius: 50%;
      background: #a8ff29;
      border: 2px solid #090a0d;
      box-shadow: 0 0 0 3px rgba(168, 255, 41, 0.25);
      cursor: pointer;
    }

    :global(:root[data-theme="light"]) .gu-slider::-webkit-slider-thumb {
      background: #059669;
      border-color: #ffffff;
      box-shadow: 0 0 0 3px rgba(5, 150, 105, 0.22);
    }

    :global(:root[data-theme="light"]) .gu-slider::-moz-range-thumb {
      background: #059669;
      border-color: #ffffff;
      box-shadow: 0 0 0 3px rgba(5, 150, 105, 0.22);
    }

    .gu-calc-metrics {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 8px;
    }

    .gu-metric {
      background: var(--bg-inset);
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 9px 10px;
      display: flex;
      flex-direction: column;
      gap: 2px;
    }

    .gu-m-label {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.56rem;
      font-weight: 600;
      color: var(--text-muted);
      letter-spacing: 0.04em;
    }

    .gu-m-val {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.92rem;
      font-weight: 800;
      color: var(--text);
    }

    .gu-m-val.accent {
      color: var(--lime-ink);
    }

    :global(:root[data-theme="light"]) .gu-m-val.accent {
      color: #047857;
    }

    .gu-m-val.emerald {
      color: var(--emerald-ink);
    }

    .gu-calc-verdict {
      font-size: 0.76rem;
      color: var(--text-secondary);
      line-height: 1.45;
      border-top: 1px solid var(--border-subtle);
      padding-top: 9px;
    }

    /* FREE VS. PLUS SIDE-BY-SIDE CONTRAST */
    .gu-compare-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 14px;
    }

    .gu-tier-box {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: 11px;
      padding: 16px 18px;
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    .gu-tier-box.is-free {
      opacity: 0.9;
    }

    .gu-tier-box.is-plus {
      border-color: rgba(168, 255, 41, 0.42);
      box-shadow: 0 0 0 1px rgba(168, 255, 41, 0.14), 0 10px 30px rgba(0, 0, 0, 0.28);
      background: linear-gradient(180deg, rgba(168, 255, 41, 0.045) 0%, var(--bg-card) 55%);
    }

    :global(:root[data-theme="light"]) .gu-tier-box.is-plus {
      border-color: rgba(5, 150, 105, 0.45);
      box-shadow: 0 0 0 1px rgba(5, 150, 105, 0.14), 0 8px 24px rgba(5, 150, 105, 0.08);
      background: linear-gradient(180deg, rgba(5, 150, 105, 0.05) 0%, #ffffff 60%);
    }

    .gu-tier-top {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
      flex-wrap: wrap;
    }

    .gu-tier-tag {
