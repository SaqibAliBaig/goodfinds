---
import data from '../data/tools.json';

interface Props {
  title?: string;
  activeNav?: 'explore' | 'collections' | 'compare' | 'submit' | 'saved' | '';
}

const {
  title = `${data.site.name} — ${data.site.tagline}`,
  activeNav = 'explore'
} = Astro.props;

const allToolIds = data.tools.map((t) => t.id);
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={data.site.tagline} />
  <meta name="impact-site-verification" value="9a38b535-28c1-4ecc-9e91-6d9b7c797600" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="shortcut icon" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">
  <script is:inline>
    (function () {
      const savedTheme = localStorage.getItem('goodfinds_theme');
      const prefersLight = window.matchMedia && window.matchMedia('(prefers-color-scheme: light)').matches;
      const theme = savedTheme || (prefersLight ? 'light' : 'dark');
      document.documentElement.setAttribute('data-theme', theme);

      // Clean up any stale service workers registered on localhost from prior projects
      if ('serviceWorker' in navigator) {
        navigator.serviceWorker.getRegistrations().then((registrations) => {
          for (const reg of registrations) reg.unregister();
        }).catch(() => {});
      }

      function optimizeImageLoading() {
        const vh = window.innerHeight;
        const scrollY = window.scrollY || window.pageYOffset || 0;
        document.querySelectorAll('img').forEach((img) => {
          if (!img.hasAttribute('data-image-component')) {
            img.setAttribute('data-image-component', 'true');
          }
          if (!img.hasAttribute('decoding')) {
            img.setAttribute('decoding', 'async');
          }
          const rect = img.getBoundingClientRect();
          const elementY = rect.top + scrollY;
          if (elementY <= vh) {
            if (img.getAttribute('loading') === 'lazy') {
              img.removeAttribute('loading');
            }
          } else {
            if (img.getAttribute('loading') !== 'lazy') {
              img.setAttribute('loading', 'lazy');
            }
          }
        });
      }
      window.optimizeImageLoading = optimizeImageLoading;
      window.addEventListener('resize', optimizeImageLoading, { passive: true });
      document.addEventListener('DOMContentLoaded', optimizeImageLoading);
      document.addEventListener('astro:page-load', optimizeImageLoading);
    })();
  </script>
  <style is:global>
    :root {
      --bg: #090a0d;
      --bg-topbar: rgba(9, 10, 13, 0.86);
      --bg-card: #101217;
      --bg-card-grad: #101217;
      --bg-card-hover: #151820;
      --bg-row: #0d0f14;
      --bg-row-hover: #14171f;
      --bg-input: #101217;
      --bg-inset: #0b0d11;
      --bg-icon: #171a22;
      --bg-pill: #111319;
      --bg-subtle: rgba(255, 255, 255, 0.045);
      --border: #1e222b;
      --border-subtle: #171a22;
      --border-light: #282d3a;
      --border-hover: #3d4456;
      --lime: #a8ff29;
      --lime-ink: #a8ff29;
      --lime-bright: #b6ff3b;
      --lime-glow: rgba(168, 255, 41, 0.14);
      --lime-soft: rgba(168, 255, 41, 0.08);
      --lime-border: rgba(168, 255, 41, 0.25);
      --num-bg: #171a22;
      --num-text: #f4f4f6;
      --num-border: #262b38;
      --pill-cta-bg: #161922;
      --pill-cta-text: #9ba3b8;
      --btn-primary-bg: #f4f4f6;
      --btn-primary-text: #090a0d;
      --purple: #8b5cf6;
      --emerald: #10b981;
      --emerald-ink: #34d399;
      --text: #f4f4f6;
      --text-body: #d4d7e0;
      --text-secondary: #8e95a5;
      --text-muted: #5e6575;
      --shadow-search: 0 12px 32px rgba(0, 0, 0, 0.4);
      --shadow-card: none;
      --grid-line: rgba(255, 255, 255, 0.03);
    }

    :root[data-theme="light"] {
      --bg: #f6f5f1;
      --bg-topbar: rgba(246, 245, 241, 0.88);
      --bg-card: #ffffff;
      --bg-card-grad: #ffffff;
      --bg-card-hover: #f9f8f5;
      --bg-row: #ffffff;
      --bg-row-hover: #f9f8f5;
      --bg-input: #ffffff;
      --bg-inset: #f2f1ec;
      --bg-icon: #f2f1ec;
      --bg-pill: #ffffff;
      --bg-subtle: #efeee9;
      --border: #e2e0d8;
      --border-subtle: #e8e6df;
      --border-light: #d2d0c7;
      --border-hover: #18181b;
      --lime: #18181b;
      --lime-ink: #111113;
      --lime-bright: #16a34a;
      --lime-glow: rgba(24, 24, 27, 0.06);
      --lime-soft: #f2f1ec;
      --lime-border: #d5d3ca;
      --num-bg: #f2f1ec;
      --num-text: #111113;
      --num-border: #e2e0d8;
      --pill-cta-bg: #f2f1ec;
      --pill-cta-text: #52525b;
      --btn-primary-bg: #111113;
      --btn-primary-text: #ffffff;
      --purple: #5b21b6;
      --emerald: #059669;
      --emerald-ink: #047857;
      --text: #111113;
      --text-body: #27272a;
      --text-secondary: #5a5a64;
      --text-muted: #868690;
      --shadow-search: 0 4px 20px rgba(0, 0, 0, 0.035);
      --shadow-card: 0 1px 2px rgba(0, 0, 0, 0.02);
      --grid-line: rgba(0, 0, 0, 0.035);
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      -webkit-tap-highlight-color: transparent;
    }

    body {
      background-color: var(--bg);
      color: var(--text);
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
      line-height: 1.5;
      min-height: 100vh;
      overflow-x: hidden;
      -webkit-font-smoothing: antialiased;
      transition: background-color 0.18s ease, color 0.18s ease;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    .container {
      max-width: 1140px;
      margin: 0 auto;
      padding: 0 24px;
    }

    /* ARCHITECTURAL TOP NAVBAR */
    .topbar {
      position: sticky;
      top: 0;
      z-index: 100;
      background: var(--bg-topbar);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border-bottom: 1px solid var(--border);
      padding: 12px 0;
      transition: transform 0.24s cubic-bezier(0.22, 1, 0.36, 1), background-color 0.18s ease;
      will-change: transform;
    }

    .topbar.topbar-hidden {
      transform: translateY(-100%);
    }

    /* FLOATING QUICK-TOP / SEARCH PILL */
    .quick-top-fab {
      position: fixed;
      right: 14px;
      bottom: 16px;
      z-index: 95;
      background: var(--btn-primary-bg);
      color: var(--btn-primary-text);
      border: 1px solid var(--border-light);
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.22);
      border-radius: 999px;
      height: 36px;
      padding: 0 13px;
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.7rem;
      font-weight: 700;
      display: inline-flex;
      align-items: center;
      gap: 5px;
      cursor: pointer;
      opacity: 0;
      pointer-events: none;
      transform: translateY(10px);
      transition: opacity 0.2s ease, transform 0.2s ease;
    }

    .quick-top-fab.visible {
      opacity: 1;
      pointer-events: auto;
      transform: translateY(0);
    }

    .topbar-inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
    }

    .brand-cluster {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .brand-logo {
      font-size: 1.25rem;
      font-weight: 800;
      letter-spacing: -0.04em;
      line-height: 1;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      color: var(--text);
    }

    .brand-signal {
      width: 7px;
      height: 7px;
      background: #16a34a;
      border-radius: 50%;
      display: inline-block;
    }

    :root:not([data-theme="light"]) .brand-signal {
      background: #a8ff29;
      box-shadow: 0 0 8px rgba(168, 255, 41, 0.6);
    }

    .brand-meta {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.66rem;
      font-weight: 500;
      color: var(--text-muted);
      letter-spacing: 0.04em;
      padding-left: 12px;
      border-left: 1px solid var(--border);
      line-height: 1.2;
    }

    .nav-menu {
      display: flex;
      align-items: center;
      gap: 4px;
      background: var(--bg-inset);
      border: 1px solid var(--border);
      padding: 3px;
      border-radius: 999px;
      scrollbar-width: none;
      -ms-overflow-style: none;
    }

    .nav-menu::-webkit-scrollbar {
      display: none;
    }

    .nav-link {
      font-size: 0.8rem;
      font-weight: 500;
      color: var(--text-secondary);
      padding: 5px 13px;
      border-radius: 999px;
      position: relative;
      transition: all 0.14s ease;
      display: inline-flex;
      align-items: center;
      gap: 5px;
      white-space: nowrap;
      flex-shrink: 0;
    }

    .nav-link:hover {
      color: var(--text);
    }

    .nav-link.active {
      background: var(--bg-card);
      color: var(--text);
      font-weight: 600;
      box-shadow: 0 1px 2px rgba(0, 0, 0, 0.06);
    }

    .saved-count-pill {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.65rem;
      font-weight: 700;
      background: var(--bg-subtle);
      color: var(--text);
      padding: 1px 5px;
      border-radius: 999px;
      display: none;
    }

    .topbar-actions {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .random-gem-btn,
    .theme-toggle-btn {
      background: var(--bg-card);
      border: 1px solid var(--border);
      color: var(--text-secondary);
      height: 34px;
      padding: 0 11px;
      border-radius: 8px;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-family: inherit;
      font-size: 0.76rem;
      font-weight: 500;
      cursor: pointer;
      transition: all 0.14s ease;
    }

    .random-gem-btn:hover,
    .theme-toggle-btn:hover {
      border-color: var(--border-hover);
      color: var(--text);
    }

    .kbd-mini {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.64rem;
      color: var(--text-muted);
      background: var(--bg-inset);
      border: 1px solid var(--border);
      padding: 1px 5px;
      border-radius: 4px;
    }

    .theme-toggle-btn .sun-ico {
      display: inline-block;
    }

    .theme-toggle-btn .moon-ico {
      display: none;
    }

    :root[data-theme="light"] .theme-toggle-btn .sun-ico {
      display: none;
    }

    :root[data-theme="light"] .theme-toggle-btn .moon-ico {
      display: inline-block;
    }

    .nl-pill-btn {
      background: var(--btn-primary-bg);
      color: var(--btn-primary-text);
      font-size: 0.76rem;
      font-weight: 600;
      height: 34px;
      padding: 0 14px;
      border-radius: 8px;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      transition: opacity 0.15s ease, transform 0.15s ease;
      border: none;
      cursor: pointer;
    }

    .nl-pill-btn:hover {
      opacity: 0.9;
      transform: translateY(-1px);
    }

    /* SECTION HEADERS — SWISS INDEX STYLE */
    .sec-header {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      margin: 44px 0 16px;
      padding-bottom: 12px;
      border-bottom: 1px solid var(--border);
    }

    .sec-title {
      display: inline-flex;
      align-items: baseline;
      gap: 10px;
      font-size: 1.05rem;
      font-weight: 700;
      letter-spacing: -0.02em;
    }

    .sec-index {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.72rem;
      font-weight: 500;
      color: var(--text-muted);
      letter-spacing: 0.04em;
    }

    .sec-action {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.74rem;
      font-weight: 500;
      color: var(--text-secondary);
      display: inline-flex;
      align-items: center;
      gap: 4px;
      transition: color 0.15s ease;
    }

    .sec-action:hover {
      color: var(--text);
    }

    /* EDITORIAL NEWSLETTER DISPATCH BOX */
    .kit-banner {
      margin: 56px 0 36px;
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 28px 32px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 28px;
      box-shadow: var(--shadow-card);
    }

    .kit-left {
      display: flex;
      flex-direction: column;
      gap: 6px;
      max-width: 540px;
    }

    .kit-eyebrow {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.68rem;
      font-weight: 600;
      letter-spacing: 0.06em;
      color: var(--text-muted);
      text-transform: uppercase;
      display: inline-flex;
      align-items: center;
      gap: 8px;
    }

    .kit-eyebrow-dot {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: #16a34a;
    }

    :root:not([data-theme="light"]) .kit-eyebrow-dot {
      background: #a8ff29;
    }

    .kit-copy h3 {
      font-size: 1.15rem;
      font-weight: 700;
      letter-spacing: -0.025em;
      color: var(--text);
      margin-bottom: 4px;
    }

    .kit-copy p {
      font-size: 0.84rem;
      color: var(--text-secondary);
      line-height: 1.5;
    }

    .kit-form {
      display: flex;
      align-items: center;
      gap: 8px;
      flex-shrink: 0;
    }

    .kit-input {
      background: var(--bg-inset);
      border: 1px solid var(--border);
      color: var(--text);
      padding: 10px 14px;
      border-radius: 8px;
      font-size: 0.82rem;
      font-family: inherit;
      outline: none;
      width: 240px;
      transition: border-color 0.15s ease;
    }

    .kit-input:focus {
      border-color: var(--border-hover);
    }

    .kit-submit {
      background: var(--btn-primary-bg);
      color: var(--btn-primary-text);
      font-weight: 600;
      font-size: 0.82rem;
      padding: 10px 18px;
      border-radius: 8px;
      border: none;
      cursor: pointer;
      white-space: nowrap;
      transition: opacity 0.15s ease;
    }

    .kit-submit:hover {
      opacity: 0.9;
    }

    /* ARCHITECTURAL FOOTER */
    .site-footer {
      border-top: 1px solid var(--border);
      padding: 48px 0 36px;
      margin-top: 28px;
      background: var(--bg);
    }

    .footer-grid {
      display: grid;
      grid-template-columns: minmax(0, 1.5fr) repeat(3, minmax(0, 1fr));
      gap: 36px;
      padding-bottom: 36px;
      border-bottom: 1px solid var(--border);
    }

    .footer-brand-col {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 12px;
      max-width: 340px;
    }

    .footer-brand-top {
      display: flex;
      align-items: center;
      gap: 10px;
      flex-wrap: wrap;
    }

    .footer-brand-badge {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.64rem;
      font-weight: 600;
      color: var(--text-muted);
      background: var(--bg-inset);
      border: 1px solid var(--border);
      padding: 2px 8px;
      border-radius: 6px;
      letter-spacing: 0.04em;
    }

    .footer-tagline {
      font-size: 0.82rem;
      color: var(--text-secondary);
      line-height: 1.55;
    }

    .footer-x-pill {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 7px 13px;
      border-radius: 8px;
      border: 1px solid var(--border);
      background: var(--bg-card);
      color: var(--text);
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.74rem;
      font-weight: 600;
      margin-top: 2px;
      transition: border-color 0.15s ease, transform 0.15s ease;
    }

    .footer-x-pill:hover {
      border-color: var(--border-hover);
      transform: translateY(-1px);
    }

    .footer-col {
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    .footer-col-title {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.68rem;
      font-weight: 700;
      letter-spacing: 0.06em;
      color: var(--text-muted);
      text-transform: uppercase;
      margin-bottom: 2px;
    }

    .footer-col a {
      font-size: 0.82rem;
      color: var(--text-secondary);
      transition: color 0.14s ease;
      width: fit-content;
    }

    .footer-col a:hover {
      color: var(--text);
    }

    .footer-bottom {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      flex-wrap: wrap;
      padding-top: 22px;
      font-size: 0.76rem;
      color: var(--text-muted);
    }

    .footer-bottom-right a {
      color: var(--text-secondary);
      font-weight: 600;
      transition: color 0.14s ease;
    }

    .footer-bottom-right a:hover {
      color: var(--text);
    }

    /* GLOBAL INLINE ONE-CLICK BOOKMARK BUTTON (☆ / ★) */
    .inline-save-btn {
      width: 26px;
      height: 26px;
      border-radius: 6px;
      border: 1px solid var(--border);
      background: var(--bg-inset);
      color: var(--text-muted);
      font-size: 0.82rem;
      line-height: 1;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      flex-shrink: 0;
      transition: all 0.14s ease;
    }

    .inline-save-btn:hover {
      border-color: var(--border-hover);
      color: var(--text);
      transform: scale(1.06);
    }

    .inline-save-btn.is-saved {
      background: var(--btn-primary-bg);
      color: var(--btn-primary-text);
      border-color: var(--btn-primary-bg);
    }

    /* VOLUNTARY BEEHIIV BOOSTS 1-CLICK MODAL (Triggered on Friday Dispatch Signup) */
    .boost-modal-backdrop {
      position: fixed;
      inset: 0;
      z-index: 999;
      background: rgba(0, 0, 0, 0.65);
      backdrop-filter: blur(6px);
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 20px;
    }

    .boost-modal {
      max-width: 480px;
      width: 100%;
      background: var(--bg-card);
      border: 1px solid var(--border-light);
      border-radius: 14px;
      padding: 26px;
      box-shadow: 0 20px 50px rgba(0, 0, 0, 0.45);
    }

    .boost-pill {
      display: inline-block;
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.66rem;
      font-weight: 700;
      color: var(--emerald-ink);
      background: var(--bg-inset);
      border: 1px solid var(--border);
      padding: 3px 9px;
      border-radius: 999px;
      margin-bottom: 10px;
    }

    .boost-head h3 {
      font-size: 1.15rem;
      font-weight: 800;
      letter-spacing: -0.02em;
      margin-bottom: 4px;
    }

    .boost-head p {
      font-size: 0.8rem;
      color: var(--text-secondary);
      margin-bottom: 16px;
    }

    .boost-list {
      display: flex;
      flex-direction: column;
      gap: 8px;
      margin-bottom: 18px;
    }

    .boost-card {
      display: flex;
      align-items: flex-start;
      gap: 12px;
      padding: 12px 14px;
      background: var(--bg-inset);
      border: 1px solid var(--border);
      border-radius: 8px;
      cursor: pointer;
    }

    .boost-card input {
      margin-top: 3px;
    }

    .boost-info {
      display: flex;
      flex-direction: column;
      gap: 2px;
      font-size: 0.8rem;
    }

    .boost-info span {
      font-size: 0.74rem;
      color: var(--text-secondary);
    }

    .boost-continue-btn {
      width: 100%;
      background: var(--btn-primary-bg);
      color: var(--btn-primary-text);
      font-family: inherit;
      font-size: 0.84rem;
      font-weight: 600;
      padding: 12px;
      border-radius: 8px;
      border: none;
      cursor: pointer;
    }

    @media (max-width: 940px) {
      .brand-meta {
        display: none;
      }
      .topbar-inner {
        flex-wrap: wrap;
        gap: 10px;
      }
      .nav-menu {
        order: 3;
        width: 100%;
        justify-content: space-between;
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
      }
      .nav-link {
        flex: 1;
        justify-content: center;
      }
      .kit-banner {
        flex-direction: column;
        align-items: flex-start;
        padding: 22px;
      }
      .kit-form {
        width: 100%;
      }
      .kit-input {
        flex: 1;
        min-width: 0;
      }
      .footer-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 28px;
      }
    }

    @media (max-width: 640px) {
      .container {
        padding: 0 12px;
      }
      .topbar {
        padding: 6px 0 5px;
      }
      .topbar-inner {
        gap: 5px;
      }
      .brand-cluster {
        flex-shrink: 0;
      }
      .brand-logo {
        font-size: 1.02rem;
        gap: 5px;
      }
      .brand-signal {
        width: 6px;
        height: 6px;
      }
      .topbar-actions {
        gap: 4px;
        flex-shrink: 0;
      }
      .random-gem-btn {
        height: 27px;
        padding: 0 8px;
        font-size: 0.68rem;
        gap: 4px;
        border-radius: 6px;
      }
      .theme-toggle-btn {
        height: 27px;
        width: 27px;
        padding: 0;
        justify-content: center;
        border-radius: 6px;
