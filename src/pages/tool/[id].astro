    .gu-list li strong {
      color: var(--text);
      font-weight: 600;
    }

    .gu-list li.con::before {
      content: '✕';
      position: absolute;
      left: 0;
      top: 1px;
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.7rem;
      font-weight: 800;
      color: #f59e0b;
    }

    .gu-list li.pro::before {
      content: '✓';
      position: absolute;
      left: 0;
      top: 0;
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.76rem;
      font-weight: 800;
      color: var(--lime-ink);
    }

    :global(:root[data-theme="light"]) .gu-list li.pro::before {
      color: #059669;
    }

    /* FOOTER CTA BAR */
    .gu-footer-bar {
      display: flex;
      flex-direction: column;
      gap: 10px;
      padding-top: 4px;
    }

    .gu-cta-group {
      display: flex;
      align-items: center;
      gap: 10px;
      flex-wrap: wrap;
    }

    .gu-primary-btn {
      background: #a8ff29;
      color: #090a0d;
      font-size: 0.88rem;
      font-weight: 800;
      letter-spacing: -0.01em;
      padding: 13px 22px;
      border-radius: 9px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      box-shadow: 0 6px 22px rgba(168, 255, 41, 0.24);
      transition: transform 0.14s ease, box-shadow 0.14s ease, filter 0.14s ease;
    }

    .gu-primary-btn:hover {
      transform: translateY(-1px);
      filter: brightness(1.04);
      box-shadow: 0 10px 28px rgba(168, 255, 41, 0.34);
    }

    :global(:root[data-theme="light"]) .gu-primary-btn {
      background: #059669;
      color: #ffffff;
      box-shadow: 0 6px 20px rgba(5, 150, 105, 0.24);
    }

    :global(:root[data-theme="light"]) .gu-primary-btn:hover {
      background: #047857;
      box-shadow: 0 10px 24px rgba(5, 150, 105, 0.3);
    }

    .gu-secondary-btn {
      background: var(--bg-card);
      border: 1px solid var(--border-light);
      color: var(--text);
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.74rem;
      font-weight: 600;
      padding: 12px 16px;
      border-radius: 9px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      transition: border-color 0.14s ease, background-color 0.14s ease;
    }

    .gu-secondary-btn:hover {
      border-color: var(--border-hover);
      background: var(--bg-card-hover);
    }

    .gu-disclosure {
      font-size: 0.72rem;
      color: var(--text-muted);
      line-height: 1.5;
    }

    .gu-disclosure strong {
      color: var(--text-secondary);
    }

    /* SIDEBAR GAMMA PLUS HIGHLIGHT */
    .pricing-tier-card.gamma-featured-tier {
      border-color: rgba(168, 255, 41, 0.4);
      background: linear-gradient(180deg, rgba(168, 255, 41, 0.05) 0%, var(--bg-inset) 70%);
    }

    :global(:root[data-theme="light"]) .pricing-tier-card.gamma-featured-tier {
      border-color: rgba(5, 150, 105, 0.42);
      background: linear-gradient(180deg, rgba(5, 150, 105, 0.06) 0%, var(--bg-inset) 70%);
    }

    .pt-best-badge {
      display: inline-block;
      margin-left: 6px;
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.56rem;
      font-weight: 800;
      color: #090a0d;
      background: #a8ff29;
      padding: 1px 6px;
      border-radius: 4px;
      vertical-align: middle;
    }

    :global(:root[data-theme="light"]) .pt-best-badge {
      color: #ffffff;
      background: #059669;
    }

    .pt-upgrade-cta {
      margin-top: 6px;
      display: block;
      text-align: center;
      font-size: 0.78rem;
      font-weight: 700;
      padding: 9px 12px;
      border-radius: 7px;
      background: #a8ff29;
      color: #090a0d;
      transition: opacity 0.14s ease, transform 0.14s ease;
    }

    .pt-upgrade-cta:hover {
      opacity: 0.92;
      transform: translateY(-1px);
    }

    :global(:root[data-theme="light"]) .pt-upgrade-cta {
      background: #059669;
      color: #ffffff;
    }

    /* TWO-COLUMN SPLIT */
    .dossier-split {
      display: grid;
      grid-template-columns: minmax(0, 1.58fr) minmax(0, 1fr);
    }

    .editorial-col {
      padding: 28px 32px;
      border-right: 1px solid var(--border);
      display: flex;
      flex-direction: column;
      gap: 30px;
    }

    .ed-block {
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    .ed-label {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.68rem;
      font-weight: 700;
      letter-spacing: 0.06em;
      color: var(--text-muted);
      padding-bottom: 8px;
      border-bottom: 1px solid var(--border-subtle);
    }

    .overview-paragraphs {
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    .ed-lead {
      font-size: 0.92rem;
      color: var(--text-body);
      line-height: 1.65;
    }

    .quick-meta-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 10px;
      margin-top: 4px;
    }

    .qm-box {
      background: var(--bg-inset);
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 12px 14px;
      display: flex;
      flex-direction: column;
      gap: 4px;
    }

    .qm-label {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.6rem;
      font-weight: 600;
      color: var(--text-muted);
      letter-spacing: 0.04em;
    }

    .qm-val {
      font-size: 0.8rem;
      font-weight: 600;
      color: var(--text);
      line-height: 1.4;
    }

    /* FEATURE MATRIX GRID */
    .feature-matrix-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-auto-rows: 1fr;
      gap: 10px;
    }

    .feat-card {
      background: var(--bg-inset);
      border: 1px solid var(--border);
      border-radius: 9px;
      padding: 14px 16px;
      display: flex;
      flex-direction: column;
      gap: 6px;
    }

    .feat-card-head {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .feat-num {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.66rem;
      font-weight: 700;
      background: var(--num-bg);
      color: var(--num-text);
      border: 1px solid var(--num-border);
      padding: 1px 6px;
      border-radius: 4px;
      flex-shrink: 0;
    }

    .feat-title {
      font-size: 0.86rem;
      font-weight: 700;
      color: var(--text);
      line-height: 1.3;
    }

    .feat-desc {
      font-size: 0.8rem;
      color: var(--text-secondary);
      line-height: 1.5;
    }

    /* STEP-BY-STEP WORKFLOW */
    .workflow-list {
      display: flex;
